# =============================================================================
#  lab.env  -  THE ONLY FILE YOU NORMALLY NEED TO EDIT
# =============================================================================
#  Every script in this project (Vagrantfile, scripts/*.sh, scripts/host/*.ps1)
#  reads its settings from here. Nothing is hard-coded elsewhere.
#
#  Rules (keep it simple so both Ruby and Bash can read it):
#    - One KEY=VALUE per line, NO spaces around the "=".
#    - Quotes are optional. Comments start with "#".
#    - After changing a value, see the "What do I change?" table in README.md
#      to know whether you must rebuild the VMs or just re-run one script.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Lab identity
# ---------------------------------------------------------------------------
# Prefix for VM names shown in the VirtualBox UI (e.g. "k8s-lab-k8s-master").
LAB_NAME=k8s-lab

# ---------------------------------------------------------------------------
# 2. VM image (the Ubuntu guest)
# ---------------------------------------------------------------------------
# Vagrant "box" = a ready-made Ubuntu disk image, downloaded once and cached.
BOX_NAME=bento/ubuntu-24.04
# Leave empty to take the latest box. Pin a version (e.g. 202510.26.0) later
# if you want every rebuild to be byte-for-byte identical.
BOX_VERSION=

# ---------------------------------------------------------------------------
# 3. Network (VirtualBox "host-only" network, private to your laptop)
# ---------------------------------------------------------------------------
# First three octets of the lab network. VirtualBox allows 192.168.56.x by
# default; if you change this to another range on Linux/macOS hosts, you must
# also whitelist it in /etc/vbox/networks.conf. Windows hosts have no such rule.
NETWORK_PREFIX=192.168.56
# Last octet of the master  -> 192.168.56.10
MASTER_IP_SUFFIX=10
# Last octet of worker #1; worker #2 gets +1, and so on -> .11, .12, ...
WORKER_IP_START=11

# ---------------------------------------------------------------------------
# 4. Cluster size and VM hardware
# ---------------------------------------------------------------------------
# Number of worker nodes (1 master is fixed).
WORKER_COUNT=2

# Master (control plane) is light: it only runs API server, etcd, scheduler.
# kubeadm refuses to start below 2 CPUs / ~1.7 GB RAM, so 2 / 3072 is the
# comfortable minimum once Calico and the operator are added.
MASTER_CPUS=2
MASTER_MEMORY_MB=3072

# Workers run the vulnerable apps, so they get more memory.
WORKER_CPUS=2
WORKER_MEMORY_MB=4096

# ---------------------------------------------------------------------------
# 5. Kubernetes
# ---------------------------------------------------------------------------
# Minor version used for the apt repository at pkgs.k8s.io (format: vX.YY).
# Check https://kubernetes.io/releases/ and pick a currently-supported minor.
# The newest patch of that minor is installed automatically.
K8S_MINOR=v1.35

# Pod and Service IP ranges. They must NOT overlap with each other or with
# NETWORK_PREFIX. The defaults are safe for this lab.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# How long the "join workers" token stays valid (used by 02 and 05 scripts).
JOIN_TOKEN_TTL=24h

# ---------------------------------------------------------------------------
# 6. Network plugin (CNI): Calico, installed through its operator
# ---------------------------------------------------------------------------
# Check https://github.com/projectcalico/calico/releases and pick a release
# that supports your K8S_MINOR (see Calico's "requirements" docs page).
CALICO_VERSION=v3.31.0
# VXLAN works inside VirtualBox without extra tweaks. Keep it unless you know why.
CALICO_ENCAPSULATION=VXLAN

# ---------------------------------------------------------------------------
# 7. Pentest target #1: Kubernetes Goat (scripts/06 - 08)
# ---------------------------------------------------------------------------
# Git ref (tag, branch or commit) of https://github.com/madhuakula/kubernetes-goat
# This commit was reviewed when the lab was written (2026-04-17). To get the
# newest content change it to "master" - at the cost of reproducibility.
GOAT_REF=723a0db478f050d173d23b4ce5044b65bce0bdd0

# Helm is needed by Kubernetes Goat. The binary is downloaded from get.helm.sh
# and its SHA-256 checksum is verified before installing.
HELM_VERSION=v3.18.4
